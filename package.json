{
  "name": "tudou-pet",
  "version": "0.1.5",
  "private": true,
  "description": "小土豆 - 桌宠 + 便利贴",
  "main": "main.js",
  "dataDir": "tudou-pet",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.kuma.tudou",
    "productName": "小土豆",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!TUTORIAL.md"
    ],
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-安装包-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-免安装-${version}.${ext}"
    }
  }
}
